{
  "$comment": "Synthetic local facts shared by reference/Swift/Kotlin. Selection precedes unread/name filtering; ineligible candidates model cleared, left, invited and group rooms. Histories are retained.",
  "cases": [
    {
      "name": "empty",
      "candidates": [],
      "expected": {}
    },
    {
      "name": "newest regardless of input order",
      "candidates": [
        {
          "roomId": "!old:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 10,
          "eligible": true
        },
        {
          "roomId": "!new:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 20,
          "eligible": true
        },
        {
          "roomId": "!other:example.test",
          "peerUserId": "@rui:example.test",
          "latestActivityMs": 5,
          "eligible": true
        }
      ],
      "expected": {
        "@ana:example.test": "!new:example.test",
        "@rui:example.test": "!other:example.test"
      }
    },
    {
      "name": "ineligible rooms excluded",
      "candidates": [
        {
          "roomId": "!keep:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 10,
          "eligible": true
        },
        {
          "roomId": "!cleared:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 20,
          "eligible": false
        },
        {
          "roomId": "!left:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 30,
          "eligible": false
        },
        {
          "roomId": "!invited:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 40,
          "eligible": false
        },
        {
          "roomId": "!group:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 50,
          "eligible": false
        }
      ],
      "expected": {
        "@ana:example.test": "!keep:example.test"
      }
    },
    {
      "name": "stable ties and missing activity",
      "candidates": [
        {
          "roomId": "!z:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 20,
          "eligible": true
        },
        {
          "roomId": "!a:example.test",
          "peerUserId": "@ana:example.test",
          "latestActivityMs": 20,
          "eligible": true
        },
        {
          "roomId": "!missing:example.test",
