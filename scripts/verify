#!/bin/sh
# Runs the generator checks of the required CI checks (checks.yml: trust-facts, lockstep), against the sibling clones on disk.
# It does not run check-removed.mjs or parity.mjs --issues; CI does.
# The pre-push hook in .githooks calls it.
# Usage: scripts/verify [--all]
set -eu
cd "$(git rev-parse --show-toplevel)"
base=$(git merge-base HEAD origin/main 2>/dev/null || echo HEAD)
# product/appstore.md is data: tools parse and check it, so a change to it runs the checks.
if [ "${1:-}" != --all ] && [ -z "$(git diff --name-only "$base" HEAD | grep -v '\.md$' || true)" ] \
  && [ -z "$(git diff --name-only "$base" HEAD | grep -x 'product/appstore.md' || true)" ]; then
  echo "verify: only Markdown changed since origin/main, nothing to check (scripts/verify --all forces it)"
  exit 0
fi
node --test tools/*.test.mjs
node tools/check-contract.mjs
node tools/check-drift.mjs --against worktree
node tools/parity.mjs
echo "verify: ok"
