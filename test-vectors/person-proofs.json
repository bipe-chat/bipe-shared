{
  "$comment": "Hand-written cases for personProofs (ADR 0275, registries/schemes.json). tools/gen-test-vectors.mjs checks each expected outcome against the reference implementation and writes test-vectors/person-proofs.json. Payloads here already passed the badge check; only the fields that the rule reads are present. The first proof draws the compact seal. extraSchemes: test-only schemes (country ZZ) added to registries/schemes.json for that vector. Brazilian proofs come first (ADR 0272 decision 7), then other countries', each group strongest first.",
  "vectors": [
    {
      "name": "pix only",
      "payloads": [
        {
          "lvl": "pix"
        }
      ],
      "expected": [
        {
          "scheme": "br.pix",
          "assurance": "bank",
          "mark": "regular"
        }
      ]
    },
    {
      "name": "govbr only",
      "payloads": [
        {
          "lvl": "govbr"
        }
      ],
      "expected": [
        {
          "scheme": "br.govbr",
          "assurance": "state",
          "mark": "fill"
        }
      ]
    },
    {
      "name": "both, pix first in the answer: strongest first",
      "payloads": [
        {
          "lvl": "pix"
        },
        {
          "lvl": "govbr"
        }
      ],
      "expected": [
        {
          "scheme": "br.govbr",
          "assurance": "state",
          "mark": "fill"
        },
        {
          "scheme": "br.pix",
          "assurance": "bank",
          "mark": "regular"
        }
      ]
    },
    {
      "name": "same scheme twice: one proof",
      "payloads": [
        {
          "lvl": "pix"
        },
        {
          "lvl": "pix"
        }
      ],
      "expected": [
        {
          "scheme": "br.pix",
          "assurance": "bank",
          "mark": "regular"
        }
      ]
    },
    {
      "name": "the scheme form of an alias",
      "payloads": [
        {
          "lvl": "person",
          "scheme": "br.govbr"
        }
      ],
      "expected": [
        {
          "scheme": "br.govbr",
          "assurance": "state",
          "mark": "fill"
        }
      ]
    },
    {
      "name": "alias and scheme form together: one proof",
      "payloads": [
        {
          "lvl": "govbr"
        },
        {
          "lvl": "person",
          "scheme": "br.govbr"
        }
      ],
      "expected": [
        {
          "scheme": "br.govbr",
          "assurance": "state",
          "mark": "fill"
        }
      ]
    },
    {
      "name": "unknown scheme: no level",
      "payloads": [
        {
          "lvl": "person",
          "scheme": "zz.test"
        }
      ],
      "expected": []
    },
    {
      "name": "unknown level: no level",
      "payloads": [
        {
          "lvl": "foo"
        }
      ],
      "expected": []
    },
    {
      "name": "a company is no person proof",
      "payloads": [
        {
          "lvl": "cnpj"
        }
      ],
      "expected": []
    },
    {
      "name": "an org scheme under lvl person: no level",
      "payloads": [
        {
          "lvl": "person",
          "scheme": "br.cnpj"
        }
      ],
      "expected": []
    },
    {
      "name": "unknown beside a good one: the good one stays",
      "payloads": [
        {
          "lvl": "person",
          "scheme": "zz.test"
        },
        {
          "lvl": "pix"
        }
      ],
      "expected": [
        {
          "scheme": "br.pix",
          "assurance": "bank",
          "mark": "regular"
        }
      ]
    },
    {
      "name": "nothing",
      "payloads": [],
      "expected": []
    },
    {
      "name": "a foreign state proof after a Brazilian bank proof",
      "extraSchemes": [
        {
          "id": "zz.state",
          "country": "ZZ",
          "class": "person",
          "assurance": "state",
          "names": {
            "pt-BR": "Teste Estado",
            "en": "Test State"
          }
        },
        {
          "id": "zz.bank",
          "country": "ZZ",
          "class": "person",
          "assurance": "bank",
          "names": {
            "pt-BR": "Teste Banco",
            "en": "Test Bank"
          }
        }
      ],
      "payloads": [
        {
          "lvl": "person",
          "scheme": "zz.state"
        },
        {
          "lvl": "pix"
        }
      ],
      "expected": [
        {
          "scheme": "br.pix",
          "assurance": "bank",
          "mark": "regular"
        },
        {
          "scheme": "zz.state",
          "assurance": "state",
          "mark": "fill"
        }
      ]
    },
    {
      "name": "foreign proofs: strongest first",
      "extraSchemes": [
        {
          "id": "zz.state",
          "country": "ZZ",
          "class": "person",
          "assurance": "state",
          "names": {
            "pt-BR": "Teste Estado",
            "en": "Test State"
          }
        },
        {
          "id": "zz.bank",
          "country": "ZZ",
          "class": "person",
          "assurance": "bank",
          "names": {
            "pt-BR": "Teste Banco",
            "en": "Test Bank"
          }
        }
      ],
      "payloads": [
        {
          "lvl": "person",
          "scheme": "zz.bank"
        },
        {
          "lvl": "person",
          "scheme": "zz.state"
        }
      ],
      "expected": [
        {
          "scheme": "zz.state",
          "assurance": "state",
          "mark": "fill"
        },
        {
          "scheme": "zz.bank",
          "assurance": "bank",
          "mark": "regular"
        }
      ]
    },
    {
      "name": "Brazil, then the foreign proofs, each strongest first",
      "extraSchemes": [
        {
          "id": "zz.state",
          "country": "ZZ",
          "class": "person",
          "assurance": "state",
          "names": {
            "pt-BR": "Teste Estado",
            "en": "Test State"
          }
        },
        {
          "id": "zz.bank",
          "country": "ZZ",
          "class": "person",
          "assurance": "bank",
          "names": {
            "pt-BR": "Teste Banco",
            "en": "Test Bank"
          }
        }
      ],
      "payloads": [
        {
          "lvl": "person",
          "scheme": "zz.bank"
        },
        {
          "lvl": "pix"
        },
        {
          "lvl": "person",
          "scheme": "zz.state"
        },
        {
          "lvl": "govbr"
        }
      ],
      "expected": [
        {
          "scheme": "br.govbr",
          "assurance": "state",
          "mark": "fill"
        },
        {
          "scheme": "br.pix",
          "assurance": "bank",
          "mark": "regular"
        },
        {
          "scheme": "zz.state",
          "assurance": "state",
          "mark": "fill"
        },
        {
          "scheme": "zz.bank",
          "assurance": "bank",
          "mark": "regular"
        }
      ]
    }
  ]
}
