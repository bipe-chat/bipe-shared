{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CatalogPrice": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "text"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "fixed",
                "from"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "description": "Display price, for example R$ 40. No payment is made by this API."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "const": "on_request"
            }
          }
        }
      ]
    },
    "CatalogItemInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "price",
        "active",
        "sort"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "product"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "price": {
          "$ref": "#/$defs/CatalogPrice"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Plain text. Clients never make links clickable."
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "active": {
          "type": "boolean"
        },
        "sort": {
          "type": "integer",
          "minimum": 0
        },
        "sold_out_today": {
          "type": "boolean",
          "default": false
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "buffer_before_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "buffer_after_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "agenda_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "product"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "duration_minutes"
                  ]
                },
                {
                  "required": [
                    "buffer_before_minutes"
                  ]
                },
                {
                  "required": [
                    "buffer_after_minutes"
                  ]
                },
                {
                  "required": [
                    "agenda_ids"
                  ]
                }
              ]
            }
          }
        }
      ],
      "description": "Full item replacement. Scheduling fields apply only to services. Omit them when the Agenda is off. A product cannot carry scheduling fields."
    },
    "CatalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "price",
        "active",
        "sort"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "product"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "price": {
          "$ref": "#/$defs/CatalogPrice"
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Plain text. Clients never make links clickable."
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "active": {
          "type": "boolean"
        },
        "sort": {
          "type": "integer",
          "minimum": 0
        },
        "sold_out_today": {
          "type": "boolean",
          "default": false
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "buffer_before_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "buffer_after_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "agenda_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "readOnly": true
        },
        "photo": {
          "type": "string",
          "format": "uri",
          "readOnly": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "product"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "duration_minutes"
                  ]
                },
                {
                  "required": [
                    "buffer_before_minutes"
                  ]
                },
                {
                  "required": [
                    "buffer_after_minutes"
                  ]
                },
                {
                  "required": [
                    "agenda_ids"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "Catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogItem"
          }
        }
      }
    },
    "CatalogOrder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ids"
      ],
      "properties": {
        "item_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true
        }
      },
      "description": "Every item ID in the catalogue, exactly once. Order determines sort."
    },
    "Service": {
      "$ref": "#/$defs/CatalogItem",
      "properties": {
        "kind": {
          "const": "service"
        }
      },
      "required": [
        "duration_minutes",
        "buffer_before_minutes",
        "buffer_after_minutes",
        "agenda_ids"
      ],
      "description": "The same Catálogo item, with kind service and complete scheduling fields. Never a separate record or ID."
    },
    "ServiceInput": {
      "$ref": "#/$defs/CatalogItemInput",
      "properties": {
        "kind": {
          "const": "service"
        }
      },
      "required": [
        "duration_minutes",
        "buffer_before_minutes",
        "buffer_after_minutes",
        "agenda_ids"
      ]
    },
    "AgendaInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "active",
        "sort"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photo": {
          "type": "string",
          "format": "uri"
        },
        "active": {
          "type": "boolean"
        },
        "sort": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Agenda": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "active",
        "sort"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photo": {
          "type": "string",
          "format": "uri"
        },
        "active": {
          "type": "boolean"
        },
        "sort": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Availability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weekday",
        "start",
        "end"
      ],
      "properties": {
        "weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7,
          "description": "ISO weekday: Monday 1 through Sunday 7."
        },
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Local wall time in the business time zone. Start is inclusive; end is exclusive."
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Local wall time in the business time zone. Start is inclusive; end is exclusive."
        }
      },
      "description": "Several non-overlapping ranges per weekday are allowed. End must follow start. A missing weekday is closed."
    },
    "AvailabilityRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Availability"
          }
        }
      }
    },
    "TimeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Local wall time in the business time zone. Start is inclusive; end is exclusive."
        },
        "end": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
          "description": "Local wall time in the business time zone. Start is inclusive; end is exclusive."
        }
      },
      "description": "End must follow start; ranges cannot overlap."
    },
    "OverrideInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agenda_id",
        "date_from",
        "date_to",
        "closed",
        "ranges"
      ],
      "properties": {
        "agenda_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        },
        "closed": {
          "type": "boolean"
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeRange"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "closed": {
                "const": true
              }
            },
            "required": [
              "closed"
            ]
          },
          "then": {
            "properties": {
              "ranges": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "ranges": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "description": "Inclusive local dates; date_to must not precede date_from. Replaces weekly hours on those dates. Overlapping overrides for an agenda are rejected. Closed means no ranges."
    },
    "Override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agenda_id",
        "date_from",
        "date_to",
        "closed",
        "ranges"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agenda_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "date_from": {
          "type": "string",
          "format": "date"
        },
        "date_to": {
          "type": "string",
          "format": "date"
        },
        "closed": {
          "type": "boolean"
        },
        "ranges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeRange"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "closed": {
                "const": true
              }
            },
            "required": [
              "closed"
            ]
          },
          "then": {
            "properties": {
              "ranges": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "ranges": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "AgendaBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agenda_ids",
        "start",
        "end"
      ],
      "properties": {
        "agenda_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        }
      },
      "description": "Subtract this interval from the affected local days, creating or replacing hours overrides. End must follow start. Does not cancel bookings."
    },
    "AgendaCloseDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agenda_ids",
        "date"
      ],
      "properties": {
        "agenda_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "date": {
          "type": "string",
          "format": "date"
        }
      },
      "description": "Close the local day by setting closed overrides. Bookings remain until the owner cancels them. No message is sent automatically."
    },
    "Policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_notice_minutes",
        "horizon_days",
        "slot_step_minutes",
        "cancel_window_minutes",
        "confirm_mode",
        "max_open_bookings_per_customer",
        "reminder_minutes"
      ],
      "properties": {
        "min_notice_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "horizon_days": {
          "type": "integer",
          "minimum": 1
        },
        "slot_step_minutes": {
          "type": "integer",
          "minimum": 1,
          "default": 15
        },
        "cancel_window_minutes": {
          "type": "integer",
          "minimum": 0,
          "default": 120
        },
        "confirm_mode": {
          "type": "string",
          "enum": [
            "auto",
            "request"
          ],
          "default": "auto"
        },
        "max_open_bookings_per_customer": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "reminder_minutes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true,
          "default": [
            1440,
            120
          ]
        }
      },
      "description": "Defaults follow ADR 0103. Request mode is reserved for slice 2. An empty reminder list disables reminders."
    },
    "AgendaSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published",
        "time_zone"
      ],
      "properties": {
        "published": {
          "type": "boolean"
        },
        "time_zone": {
          "type": "string",
          "default": "America/Sao_Paulo",
          "description": "IANA time zone. Changing it does not move existing UTC bookings."
        }
      }
    },
    "AgendaActivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "time_zone": {
          "type": "string",
          "default": "America/Sao_Paulo"
        }
      }
    },
    "AgendaState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "published",
        "time_zone",
        "agendas",
        "services",
        "policy"
      ],
      "properties": {
        "published": {
          "type": "boolean"
        },
        "time_zone": {
          "type": "string",
          "default": "America/Sao_Paulo"
        },
        "agendas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Agenda"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Service"
          }
        },
        "policy": {
          "$ref": "#/$defs/Policy"
        }
      }
    },
    "BookingStatus": {
      "type": "string",
      "enum": [
        "held",
        "requested",
        "confirmed",
        "done",
        "cancelled",
        "no_show"
      ]
    },
    "BookingCustomer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "user_id"
          ],
          "properties": {
            "user_id": {
              "type": "string",
              "pattern": "^@[^:]+:.+$"
            }
          },
          "description": "The signed-in customer. The API derives this ID from authentication for customer routes."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "description": "Owner-entered walk-in only. No chat card or reminders. Also used after account deletion (ADR 0103)."
        }
      ]
    },
    "Booking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "business_id",
        "service_id",
        "agenda_id",
        "start",
        "end",
        "status",
        "customer",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "business_id": {
          "type": "string",
          "pattern": "^@[^:]+:.+$"
        },
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agenda_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        },
        "status": {
          "$ref": "#/$defs/BookingStatus"
        },
        "customer": {
          "$ref": "#/$defs/BookingCustomer"
        },
        "source": {
          "type": "string",
          "enum": [
            "customer",
            "owner"
          ]
        },
        "hold_expires_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        }
      },
      "description": "Minimal record (ADR 0102). No notes, address, allergy, message or other customer text. The only name is a name-only owner entry or a retained name after account deletion. End and hold expiry are server-derived. A held row expires five minutes after creation."
    },
    "BookingHold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "agenda_id",
        "start"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agenda_id": {
          "type": "string",
          "description": "An eligible agenda ID or any. For any, the server chooses at hold time: least booked that local day, then agenda sort and ID."
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        }
      },
      "description": "Authenticated customer only. Customer, end, status and expiry are server-derived. Rate and open-booking limits apply."
    },
    "OwnerBooking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "service_id",
        "agenda_id",
        "start",
        "customer"
      ],
      "properties": {
        "service_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agenda_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        },
        "customer": {
          "$ref": "#/$defs/BookingCustomer"
        }
      },
      "description": "Encaixe. Owner route only. Availability and exclusion rules still apply."
    },
    "BookingMove": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agenda_id",
        "start"
      ],
      "properties": {
        "agenda_id": {
          "type": "string",
          "description": "Agenda ID or any on customer routes; an agenda ID on owner routes."
        },
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        }
      },
      "description": "Keep the same service. Replace atomically; a conflict leaves the original booking unchanged. The API derives the end and rechecks policy."
    },
    "Slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        }
      },
      "description": "Free time only, with no booking or customer information. For any, agenda selection happens at hold time."
    },
    "SlotDay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "slots"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slot"
          }
        }
      },
      "description": "Date in the business time zone. Include the day with an empty list when full."
    },
    "SlotDays": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_zone",
        "days"
      ],
      "properties": {
        "time_zone": {
          "type": "string"
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SlotDay"
          }
        }
      }
    },
    "AgendaFeedOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "include_customer_first_name"
      ],
      "properties": {
        "include_customer_first_name": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "AgendaFeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "include_customer_first_name"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Returned once. Contains a 32-byte random token; only its hash is stored. Reissuing revokes the previous token."
        },
        "include_customer_first_name": {
          "type": "boolean"
        }
      },
      "description": "Secret URL. Default ICS SUMMARY is Agendado. Never log the token or feed URL."
    },
    "BusyImportInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Secret ICS URL. Server resolves and checks every address and redirect; refuses private and link-local addresses; caps redirects, bytes and time. Never log this URL."
        }
      }
    },
    "BusyImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "agenda_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "agenda_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "last_checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "description": "UTC, with a trailing Z."
        }
      },
      "description": "Fetch every 15 minutes; retain start and end only, never titles or descriptions. Do not return the secret URL."
    },
    "AgendaError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "enum": [
            "bad_request",
            "unauthorized",
            "not_found",
            "rate_limited",
            "internal",
            "slot_taken",
            "hold_expired",
            "too_many_open_bookings",
            "outside_notice",
            "outside_horizon",
            "agenda_not_published",
            "cancellation_window_closed"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
