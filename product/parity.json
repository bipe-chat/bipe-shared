    {
      "area": "Dev app ID",
      "ios": "`chat.bipe.app.dev`",
      "android": "`chat.bipe.app.debug`",
      "reason": "Element's build-type suffix on each platform",
      "kind": "idiom"
    },
    {
      "area": "OAuth redirect",
      "ios": "`<bundle id>:/oauth/callback`",
      "android": "`<application id>:/`",
      "reason": "Element's default per platform; both are reverse-domain private-use schemes",
      "kind": "idiom"
    },
    {
      "area": "Push",
      "ios": "APNs through Sygnal",
      "android": "FCM through Sygnal; UnifiedPush optional",
      "reason": "OS push channel (#89, #90, #91)",
      "kind": "idiom"
    },
    {
      "area": "Sign-up attestation",
      "ios": "App Attest",
      "android": "None yet",
      "reason": "Play Integrity not built on Android (#92)",
      "kind": "gap",
      "issue": 92
    },
    {
      "area": "Criar conta da empresa",
      "ios": "In Sua conta on a phone with App Attest",
      "android": "Not shown",
      "reason": "A company account needs an attested device (ADR 0043, ADR 0087); Play Integrity not built on Android (#92)",
      "kind": "gap",
      "issue": 92
    },
    {
      "area": "Synced recovery token",
      "ios": "iCloud Keychain",
      "android": "Block Store (gplay); none in the F-Droid build",
      "reason": "Platform credential store (ADR 0059). F-Droid has no Google Play services",
      "kind": "idiom"
    },
    {
      "area": "App lock",
      "ios": "Element's lock screen, the account PIN, biometrics on",
      "android": "Element's lock screen, 8-digit account PIN, biometric option",
      "reason": "Element X lock screen per platform",
      "kind": "idiom"
    },
    {
      "area": "Check before a PIN change",
      "ios": "Biometrics or the phone's passcode",
      "android": "Biometrics or the phone's screen lock; else the app lock PIN",
      "reason": "`LAContext` on iOS, `BiometricPrompt` with `DEVICE_CREDENTIAL` on Android",
      "kind": "idiom"
    },
    {
      "area": "Invite code input",
      "ios": "Paste button",
      "android": "Pasted text collapses to the code in the field",
