          "latestActivityMs": null,
          "eligible": true
        },
        {
          "roomId": "!z:example.test",
          "peerUserId": "@rui:example.test",
          "latestActivityMs": null,
          "eligible": true
        },
        {
          "roomId": "!a:example.test",
          "peerUserId": "@rui:example.test",
          "latestActivityMs": null,
          "eligible": true
        }
      ],
      "expected": {
        "@ana:example.test": "!a:example.test",
        "@rui:example.test": "!a:example.test"
      }
    },
    {
      "name": "missing stable identities excluded",
      "candidates": [
        {
          "roomId": "!room:example.test",
          "peerUserId": "",
          "latestActivityMs": 20,
          "eligible": true
