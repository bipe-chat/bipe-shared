{
  "$comment": "Bipe's own colour tokens for bipe-app (bipe-chat/bipe#551). Edit themes, rampParameters, semantic and appThemes; then run node design/ramps/ramp.mjs --write to solve ramps, and node tools/gen.mjs. Never hand-edit ramps. Contrast targets: bipe/docs/design/identity.md. Semantic roles: identity.md and trust-ui.md.",
  "themes": {
    "light": {
      "background": "#FFFFFF",
      "contrastTargets": [
        1.03,
        1.06,
        1.12,
        1.25,
        1.5,
        1.75,
        2.25,
        3.5,
        5.25,
        6.5,
        8,
        10.5,
        13.75,
        16.75
      ]
    },
    "dark": {
      "background": "#101317",
      "contrastTargets": [
        1.03,
        1.06,
        1.12,
        1.25,
        1.5,
        1.75,
        2.25,
        3.5,
        5.25,
        6.5,
        8,
        10.5,
        13.75,
        16
      ]
    }
  },
  "rampParameters": {
    "acai": {
      "hue": 330,
      "peakChroma": 0.155,
      "use": "Brand plum. Accent and the verified trust state (acai.1100)."
    },
    "gray": {
      "hue": 255,
      "peakChroma": 0.012,
      "use": "Surfaces, ink, lines and the neutral trust state."
    },
    "amber": {
      "hue": 58,
      "peakChroma": 0.13,
      "use": "Caution trust state. Not orange: orange is too close to red."
    },
    "red": {
      "hue": 27,
      "peakChroma": 0.19,
      "use": "Danger trust state only (confirmed danger)."
    },
    "green": {
      "hue": 150,
      "peakChroma": 0.13,
      "use": "Success. Rare: verified is plum, not green."
    },
    "pitanga": {
      "hue": 42,
      "peakChroma": 0.2,
      "use": "Red-orange of the pitanga, off danger red (hue 27). Expressive: backgrounds of marketing images and site art (bipe-web). In the app only as an app theme (appThemes, bipe-chat/bipe#811): the themed accent and own-bubble tokens and the app icon. Never trust states."
    },
    "caju": {
      "hue": 75,
      "peakChroma": 0.145,
      "shade": {
        "hue": 56,
        "lightness": [
          0.45,
          0.7
        ]
      },
      "use": "Warm orange-yellow, orange-brown in the dark steps. It sits on caution amber, so it is not an app theme. Expressive: backgrounds of marketing images and site art (bipe-web) only. Never in the app."
    },
    "jabuticaba": {
      "hue": 285,
      "peakChroma": 0.13,
      "use": "Violet of the jabuticaba, turned away from acai (hue 330). Expressive: backgrounds of marketing images and site art (bipe-web). In the app only as an app theme (appThemes, bipe-chat/bipe#811): the themed accent and own-bubble tokens and the app icon. Never trust states."
    },
    "jenipapo": {
      "hue": 233,
      "peakChroma": 0.1125,
      "use": "Blue-black of the jenipapo dye. Expressive: backgrounds of marketing images and site art (bipe-web). In the app only as an app theme (appThemes, bipe-chat/bipe#811): the themed accent and own-bubble tokens and the app icon. Never trust states."
    },
    "goiaba": {
      "hue": 355,
      "peakChroma": 0.2,
      "use": "Pink of the goiaba flesh. In the app only as an app theme (appThemes, bipe-chat/bipe#811): the themed accent and own-bubble tokens and the app icon. Never trust states."
    },
    "maracuja": {
      "hue": 100,
      "peakChroma": 0.2,
      "use": "Yellow of the maracuja rind; mustard at the accent steps on white, gold on dark. In the app only as an app theme (appThemes, bipe-chat/bipe#811): the themed accent and own-bubble tokens and the app icon. Never trust states."
    }
  },
